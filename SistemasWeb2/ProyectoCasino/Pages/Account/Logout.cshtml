@page
@model ProyectoCasino.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-6 offset-md-3">
        <section>
            <h2>¿Estás seguro de que deseas cerrar sesión?</h2>
            <hr />
            <form method="post">
                <button type="submit" class="btn btn-danger">Sí, cerrar sesión</button>
                <a asp-page="/Index" class="btn btn-secondary">No, volver al inicio</a>
            </form>
        </section>
    </div>
</div>
