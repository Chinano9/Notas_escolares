@page
@model IndexModel
@{
    ViewData["Title"] = "Casino Online";
}

<div class="text-center">
    <h1 class="display-4">Bienvenido al Casino Online</h1>
    <p>La mejor experiencia de juego en línea a tu alcance.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="mt-4">
            <h3>¡Bienvenido de vuelta, @User.Identity.Name!</h3>
            <p>Listo para empezar a jugar.</p>
            <a class="btn btn-primary btn-lg mt-3" href="#">Juegos Disponibles</a>
        </div>
    }
    else
    {
        <div class="mt-4">
            <p>Inicia sesión o regístrate para comenzar a jugar.</p>
            <div class="d-flex justify-content-center gap-3 mt-3">
                <a class="btn btn-primary" asp-page="/Account/Login">Iniciar Sesión</a>
                <a class="btn btn-success" asp-page="/Account/Register">Registrarse</a>
            </div>
        </div>
    }
</div>
