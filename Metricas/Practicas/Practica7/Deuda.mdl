{UTF-8}
Otros Gastos=Ingresos*0.1
	~	
	~		|

Deficit=
	Ingresos-Gastos Totales
	~	
	~		|

Deuda= INTEG (
	-Deficit,
		2.5e+06)
	~	
	~		|

Gastos Totales=
	Interes+Otros Gastos
	~	
	~		|

Ingresos=
	235000
	~	
	~		|

Interes=
	Deuda*0.015
	~	
	~		|

Tasa de Interes Total=
	(Interes/2.5e+06)*100
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2039
	~	Quarter
	~	The final time for the simulation.
	|

INITIAL TIME  = 2025
	~	Quarter
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Quarter [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.333333
	~	Quarter [0,?]
	~	The time step for the simulation.
	|

